# Copy to .env.local for development. Every key is optional in dev:
# without it, the matching dev fallback is used (see replica/backend.md).

# Postgres connection string (Neon in production)
DATABASE_URL=postgres://ride:ride@localhost:5432/ride

# Public base URL, used in share links, receipts and Stripe redirects
APP_URL=http://localhost:3000

# Set to 1 only in local dev/test: shows the SMS code on screen when no SMS provider is set
DEV_SHOW_OTP=1

# Test deployments only: on-screen sign-in codes, test cards, simulated driving, and a "test version" banner.
# Anyone with the link can sign in as any number. Never set this on a real launch.
DEMO_MODE=

# SMS one-time codes (Twilio Verify) and notifications
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Email receipts (Resend), from a verified domain
RESEND_API_KEY=
EMAIL_FROM=

# Maps, routing and address search (Mapbox). Public token, URL-restricted to your domain.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Stripe (test keys until replica-deploy)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vercel Cron shared secret for /api/cron/cleanup
CRON_SECRET=
