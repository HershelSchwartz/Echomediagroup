{
  "name": "echoride",
  "version": "0.1.0",
  "private": true,
  "description": "A from-scratch ride-hailing app: dispatch server plus rider and driver web apps.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "mobile:build": "node scripts/build-mobile.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "4.22.3",
    "leaflet": "1.9.4",
    "socket.io": "4.8.1",
    "socket.io-client": "4.8.1"
  }
}
